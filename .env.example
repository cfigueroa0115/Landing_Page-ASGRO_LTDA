# ==============================================================================
# ASGRO Landing Page - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — Always
# ------------------------------------------------------------------------------

# Neon PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/asgro?sslmode=require"

# Canonical site URL (used for metadata, canonical, sitemap and robots)
# Dominio WEB = .com.co (el .com es exclusivamente para correo corporativo)
NEXT_PUBLIC_SITE_URL="https://asgroseguros.com.co"

# WhatsApp business phone number (with country code, no spaces or symbols)
# Example: 573001234567 (Colombia +57)
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — Optional in development
# (In development, if empty/missing, UI hides corresponding contact sections)
# ------------------------------------------------------------------------------

# Company phone number displayed in footer and contact sections
# Format: +57 300 123 4567 or similar
NEXT_PUBLIC_COMPANY_PHONE="+57 300 123 4567"

# Company email address for contact display
NEXT_PUBLIC_COMPANY_EMAIL="contacto@asgroseguros.com"

# Company physical address
NEXT_PUBLIC_COMPANY_ADDRESS="Carrera 57 #134-20, Bogotá D.C., Colombia"

# ------------------------------------------------------------------------------
# OPTIONAL — Social media (footer). If empty, the icon is hidden (no fake links).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""

# ------------------------------------------------------------------------------
# OPTIONAL — AI and Email Services
# (If not set, the AI agent falls back to local keyword matching)
# ------------------------------------------------------------------------------

# OpenAI API key for AI agent responses (optional — enables GPT-powered chat)
OPENAI_API_KEY=""

# Google Gemini API key (alternative to OpenAI, optional)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (server-side only — Resend). If any is missing, the lead/
# quote is still stored in the DB but no email is sent (notified:false).
# ------------------------------------------------------------------------------

# Resend API key (server-side, never exposed to the client)
RESEND_API_KEY=""

# Destination address for contact/quote notifications
CONTACT_NOTIFICATION_TO="betty.leon@asgroseguros.com"

# Verified sender for Resend (domain must be verified in Resend)
# Example: "ASGRO <no-reply@asgroseguros.com>"
CONTACT_FROM_EMAIL="ASGRO <no-reply@asgroseguros.com>"
